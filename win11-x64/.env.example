# 复制为 .env 后修改。所有项均可选，不填则使用默认值。

# ---------- 基本 ----------
PORT=8787
# 对外访问地址（用于生成登录回调地址），例如 https://lh.example.com
PUBLIC_URL=http://localhost:8787
# 登录完成后跳回的前端地址；前端由本服务托管时与 PUBLIC_URL 相同
# FRONTEND_URL=http://localhost:5173
# 用于签发登录令牌的密钥，正式部署务必设置为一串随机字符（openssl rand -hex 32）
JWT_SECRET=
TOKEN_DAYS=30
# 允许跨域访问的前端地址，逗号分隔；* 表示全部
CORS_ORIGINS=*

# ---------- 数据 ----------
# DB_FILE=data/lianghua.db
# 空数据库首次启动时是否写入演示数据。正式部署设为 false，启动日志会打印首个管理员邀请码
SEED_DEMO=true

# ---------- 登录：演示账号 ----------
# 登录页显示演示账号列表，方便测试。正式上线务必设为 false
AUTH_DEMO=true

# ---------- 登录：用 e 账户登录（yeraldo.com） ----------
# 按 e 的接入规范：授权码 + PKCE，公共客户端，没有 client_secret。详见 docs/AUTH.md
# 1) 在 https://yeraldo.com/developers 创建应用，登记回调地址 ${PUBLIC_URL}/auth/e/callback
#    （本地测试另登记 http://localhost/auth/e/callback，回环地址不写端口）
# 2) 应用「学生量化管理」的 client_id 已内置（server/src/config.js）；换应用时在这里覆盖，填空值可关闭
# E_CLIENT_ID=d792c755-94b0-4a22-95ce-f1e9ddfaa4ed
# 需要检查内测资格时填软件 slug 或 ID（必须是创建该应用的同一个 e 账户发布的软件）；不需要就留空
# E_BETA_SOFTWARE=
# 登录按钮文字
# E_LABEL=用 e 登录
# 打开应用时复查授权与内测资格的最短间隔（分钟）
# E_RECHECK_MINUTES=5
# 回调地址默认是 ${PUBLIC_URL}/auth/e/callback，必须与 e 上登记的完全一致
# E_REDIRECT_URI=

# ---------- 登录：其他身份平台（OIDC / OAuth 2.0 授权码模式） ----------
# 详见 docs/AUTH.md。支持 OIDC 的平台只需填 AUTH_ISSUER；只支持 OAuth 2.0 的平台改填三个 URL。
AUTH_LABEL=使用统一身份平台登录
# AUTH_ISSUER=https://id.example.com
# AUTH_AUTHORIZE_URL=https://id.example.com/oauth/authorize
# AUTH_TOKEN_URL=https://id.example.com/oauth/token
# AUTH_USERINFO_URL=https://id.example.com/oauth/userinfo
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# client_secret_post 或 client_secret_basic
# AUTH_TOKEN_AUTH_METHOD=client_secret_post
# AUTH_SCOPE=openid profile email phone
# AUTH_PKCE=true
# 默认回调地址为 ${PUBLIC_URL}/api/auth/oidc/callback，需要在平台中登记
# AUTH_REDIRECT_URI=

# 用户信息字段名（平台返回的字段不是标准名称时修改，支持 a.b 形式的嵌套字段）
# AUTH_CLAIM_SUB=sub
# AUTH_CLAIM_NAME=name
# AUTH_CLAIM_PHONE=phone_number
# AUTH_CLAIM_EMAIL=email
# 如果角色也由平台管理：填写角色字段名与映射（平台角色:本系统角色，本系统角色为 admin/teacher/parent）
# AUTH_CLAIM_ROLE=roles
# AUTH_ROLE_MAP=school-admin:admin,teacher:teacher,parent:parent

# ---------- 登录：微信小程序（上线小程序后填写） ----------
# WX_APPID=
# WX_SECRET=
